PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gibiconnect_db
DB_USER=postgres
DB_PASSWORD=postgres
# GIBIConnect Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:1234@127.0.0.1:5432/gibiconnect
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gibiconnect
PGUSER=postgres
PGPASSWORD=your_secure_password_here
PGPOOL_MAX=20
PG_IDLE_TIMEOUT=30000

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# AI Service Configuration (Backend Only - NEVER expose to Frontend)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-pro

# File Storage Configuration
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_BYTES=104857600
