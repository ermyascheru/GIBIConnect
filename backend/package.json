{
  "name": "gibiconnect-backend",
  "version": "1.0.0",
  "description": "Backend API and Database Engine for GIBIConnect",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca tsx watch src/server.ts",
    "build": "prisma generate && tsc && node fix-esm-imports.mjs",
    "audit": "node audit-backend.mjs",
    "start": "node dist/server.js",
    "db:neon:seed": "node seed-neon.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test:ai": "node test-ai-all-questions.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "gibiconnect",
    "ethiopia",
    "education",
    "prisma",
    "postgresql",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {}
}
